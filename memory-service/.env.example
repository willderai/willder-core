# Willder memory service: copy to .env for local dev, or set as service env vars.
# Read by app/config.py. GRAPHITI_SERVICE_API_KEY must match the repo root .env.
# The full table is ../docs/environment.md, "Memory service".

GRAPHITI_SERVICE_API_KEY=   # shared bearer secret the Node app sends

NEO4J_URI=                  # bolt://localhost:7687 locally (README "Local setup"),
                            # neo4j+s://<id>.databases.neo4j.io on AuraDB
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=             # willder-local in the README docker command
NEO4J_DATABASE=             # empty = the connection's home database (right for AuraDB)

# Connection-pool lifecycle, optional (README "Neo4j driver settings"). Defaults
# retire pooled connections before AuraDB's idle cutoff and fail fast on a dead pool.
# NEO4J_MAX_CONNECTION_LIFETIME_S=240
# NEO4J_CONNECTION_ACQUISITION_TIMEOUT_S=10
# NEO4J_LIVENESS_CHECK_TIMEOUT_S=30
# NEO4J_KEEP_ALIVE=true

# Seconds the event loop may go without running before the service exits so the
# platform restarts it (README "Event-loop watchdog"). Optional.
# LOOP_STALL_LIMIT_S=60

# Fact extraction model, any OpenAI-compatible endpoint. Only /ingest calls it;
# /search and /embed run locally and work without a real key, but the key must
# not be blank: the OpenAI client is built on the first memory call, search
# included, and rejects an empty key, so /search returns 500. For reads only,
# keep the placeholder below; set a real key to ingest. For Groq:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL_EXTRACT=meta-llama/llama-4-scout-17b-16e-instruct
OPENAI_API_KEY=not-set
OPENAI_BASE_URL=            # unset = https://api.openai.com/v1
OPENAI_MODEL_EXTRACT=       # unset = gpt-4o-mini
OPENAI_API_VERSION=         # Azure only, e.g. 2024-08-01-preview
OPENAI_EXTRACT_EXTRA_BODY=  # extra JSON fields for extraction requests, e.g. '{"reasoning_effort":"none"}'; unset = none

BGE_MODEL=BAAI/bge-small-en-v1.5   # local embedder (~130 MB)
BGE_DIM=384                        # must match the Neo4j vector index

BLOB_READ_WRITE_TOKEN=      # same value as the Node app's; /extract fetches private
                            # Vercel Blob URLs server-side and needs it to authenticate
