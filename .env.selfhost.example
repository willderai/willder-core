# A self-hosted install: copy to .env (cp .env.selfhost.example .env). docker compose and
# the Node side (npm run mcp, the selfhost:* scripts) both read that one file. These values
# match docker-compose.yml's defaults; docs/self-host.md is the walkthrough and
# docs/environment.md says what every name does.

# ---- The stack docker-compose.yml starts, published on 127.0.0.1 ----
DATABASE_URL=postgresql://postgres:willder@localhost:5432/willder
DATABASE_URL_UNPOOLED=postgresql://postgres:willder@localhost:5432/willder
GRAPHITI_SERVICE_URL=http://localhost:8000
# Any string: the memory service and the Node side share it. Change it.
GRAPHITI_SERVICE_API_KEY=change-me-to-any-string

# Ingest runs inline: a self-hosted install has no Inngest.
INNGEST_BYPASS=1

# The Prisma CLI (npx prisma migrate deploy) reports usage to checkpoint.prisma.io unless this is set.
CHECKPOINT_DISABLE=1

# ---- The model endpoint: any OpenAI-compatible server, used for writes only ----
# Fact extraction calls it; reads embed locally and never call it. As shipped it names a
# port where nothing listens, so the install calls no model: a write is still stored and
# readable, and only its graph extraction is skipped. To extract, set all three to your
# endpoint, one that both this machine and the memory service's container can reach.
# (Unset OPENAI_BASE_URL means api.openai.com.)
OPENAI_API_KEY=not-set
OPENAI_BASE_URL=http://127.0.0.1:9/v1
OPENAI_MODEL_EXTRACT=gpt-4o-mini

# ---- Optional ----
# Ports docker-compose.yml publishes (defaults 5432 and 8000). Change DATABASE_URL and
# GRAPHITI_SERVICE_URL to match.
# WILLDER_POSTGRES_PORT=5432
# WILLDER_MEMORY_PORT=8000
# WILLDER_POSTGRES_PASSWORD=willder
# WILLDER_NEO4J_PASSWORD=willder-local
# A Postgres on another machine: the selfhost:* scripts refuse one unless this is 1, and a
# database URL read from this file must be local whatever it says, so export both
# DATABASE_URL and this flag in the shell instead (docs/self-host.md).
# WILLDER_SELFHOST_ALLOW_REMOTE_DB=1
# The web app only (npm run dev): keys from a free Clerk development instance.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
