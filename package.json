{
  "name": "willder",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "willder": "cli/willder.mjs"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^20.19 || ^22.12 || >=24.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "bash build.sh",
    "start": "next start",
    "lint": "eslint",
    "lint:dead": "knip",
    "format:check": "npx --yes prettier@3.3.3 --check .",
    "scope-gate:check": "eslint --config eslint.scope-gate.config.mjs . && eslint --quiet --config eslint.memory-access.config.mjs .",
    "route-collision:check": "bash scripts/check-route-collision.sh",
    "doc-anchors:check": "node scripts/check-doc-anchors.mjs",
    "doc-paths:check": "node scripts/check-doc-paths.mjs",
    "bypass-credentials:check": "node scripts/check-bypass-credentials.mjs",
    "db:check": "bash scripts/run-check.sh scripts/check-db.ts",
    "memory:check": "bash scripts/run-check.sh scripts/check-memory.ts",
    "mcp:check": "bash scripts/run-check.sh scripts/check-mcp.ts",
    "mcp:conformance": "tsx scripts/mcp-conformance.ts",
    "audit:verify": "tsx scripts/verify-audit-chain.ts",
    "access:check": "bash scripts/run-check.sh scripts/check-access.ts",
    "campaigns:check": "bash scripts/run-check.sh scripts/check-campaigns.ts",
    "rate-limits:check": "bash scripts/run-check.sh scripts/check-rate-limits.ts",
    "guardrails:check": "bash scripts/run-check.sh scripts/check-guardrails.ts",
    "resolver:check": "bash scripts/run-check.sh scripts/check-resolver.ts",
    "capabilities:check": "bash scripts/run-check.sh scripts/check-capabilities.ts",
    "settings:check": "bash scripts/run-check.sh scripts/check-settings.ts",
    "episode-cap:check": "bash scripts/run-check.sh scripts/check-episode-cap.ts",
    "handoff:check": "bash scripts/run-check.sh scripts/check-handoff.ts",
    "fact-governance:check": "bash scripts/run-check.sh scripts/check-fact-governance.ts",
    "architecture-cron:check": "bash scripts/run-check.sh scripts/check-architecture-cron.ts",
    "qa:check": "bash scripts/run-check.sh scripts/check-qa.ts",
    "qa-browser:check": "bash scripts/run-check.sh scripts/check-qa-browser.ts",
    "check": "npm run db:check && npm run memory:check && npm run mcp:check && npm run access:check && npm run campaigns:check && npm run rate-limits:check && npm run guardrails:check && npm run resolver:check && npm run capabilities:check && npm run settings:check && npm run episode-cap:check && npm run handoff:check && npm run fact-governance:check && npm run architecture-cron:check && npm run qa:check",
    "dev:stack": "bash scripts/dev-stack.sh",
    "mcp": "bash scripts/run-check.sh mcp/server.ts",
    "selfhost:token": "bash scripts/run-check.sh scripts/selfhost-token.ts",
    "selfhost:export": "bash scripts/run-check.sh scripts/selfhost-export.ts",
    "selfhost:smoke": "bash scripts/run-check.sh scripts/selfhost-smoke.ts",
    "test": "vitest run",
    "test:leaks": "vitest run --project node eval.test.ts leak.test.ts leakage.test.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.5.0",
    "@clerk/nextjs": "^7.4.3",
    "@clerk/themes": "^2.4.57",
    "@heroui/react": "^3.1.0",
    "@mastra/core": "^0.24.9",
    "@mendable/firecrawl-js": "^1.21.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neondatabase/serverless": "^1.1.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
    "@vercel/speed-insights": "^2.0.0",
    "exa-js": "^2.13.0",
    "framer-motion": "^12.40.0",
    "inngest": "^4.5.0",
    "langfuse": "^3.38.20",
    "lucide-react": "^1.20.0",
    "mermaid": "^11.16.0",
    "neo4j-driver": "^6.1.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "openai": "^6.44.0",
    "pg": "^8.21.0",
    "posthog-js": "^1.395.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.2.0",
    "svix": "^1.95.2",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@vercel/sandbox": "^2.7.1",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "^7.8.0",
    "ai": "^4.3.19",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jsdom": "28.0.0",
    "knip": "^6.39.0",
    "prisma": "^7.8.0",
    "semver": "^7.8.2",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
