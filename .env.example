# Willder web app and scripts: copy to .env and fill in. .env is gitignored.
# Every name here is read by code in this repo or by an SDK it configures; the
# full table with file receipts, defaults and what breaks without each one is
# docs/environment.md. Values in comments are the local-setup ones from README.md.
# The memory service has its own file: memory-service/.env.example.

# ---- Required to boot (web app, scripts, npm run mcp) ----
DATABASE_URL=            # postgresql://postgres:willder@localhost:5432/willder
DATABASE_URL_UNPOOLED=   # same as DATABASE_URL locally; the direct URL on Neon (migrations)
GRAPHITI_SERVICE_URL=http://localhost:8000   # the memory service
GRAPHITI_SERVICE_API_KEY=                     # any string; the same value in memory-service/.env

# ---- Required to boot the web app only (npm run dev); npm run mcp does not need these ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=   # from a free Clerk development instance
CLERK_SECRET_KEY=                    # same instance
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in   # Clerk SDK; defaults shown
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_APP_URL=http://localhost:3000   # absolute origin for OAuth callbacks, billing and email links
CRON_SECRET=   # production only: Vercel's cron auth; GET /api/mcp answers the keep-warm ping 204 (openssl rand -hex 32)

# ---- Models: any OpenAI-compatible endpoint (Groq, OpenAI, Azure) ----
# Unset = Handoff/Architecture/QA agents, memory chat and coreference cannot call a model.
OPENAI_API_KEY=
OPENAI_BASE_URL=            # https://api.groq.com/openai/v1 for a free Groq key; unset = api.openai.com
OPENAI_API_VERSION=         # Azure only, e.g. 2024-08-01-preview; unset elsewhere
OPENAI_MODEL_EXTRACT=       # default gpt-4o-mini; Groq: meta-llama/llama-4-scout-17b-16e-instruct
OPENAI_MODEL_GENERATE=      # default gpt-4o-mini; Groq: qwen/qwen3-32b
OPENAI_MODEL_ORCHESTRATOR=  # default gpt-4o-mini; memory chat
ANTHROPIC_API_KEY=          # only for agents configured with a claude-* model

# ---- Background jobs: Inngest ----
INNGEST_DEV=1          # local: use the dev server (npx inngest-cli@latest dev). Unset in prod.
INNGEST_EVENT_KEY=     # Inngest Cloud only
INNGEST_SIGNING_KEY=   # Inngest Cloud only
INNGEST_BYPASS=        # 1 = run ingest and enrichment inline, without Inngest (scripts, dev-stack)

# ---- Secrets at rest ----
APP_ENCRYPTION_KEY=    # 64 hex chars (openssl rand -hex 32); needed by connectors and mailbox OAuth

# ---- Clerk webhook (org membership sync) ----
CLERK_WEBHOOK_SECRET=  # signing secret of the Clerk webhook endpoint; unset = the route refuses every request with 503
CLERK_WEBHOOK_SECRET_2=  # optional: signing secret of a second Clerk endpoint delivering to the same URL, e.g. during a rotation; a request is accepted when either secret verifies it

# ---- Hosted MCP endpoint: OAuth sign-in for claude.ai and ChatGPT (off by default) ----
MCP_OAUTH_ENABLED=     # true = Willder serves OAuth discovery, client registration, /oauth/authorize and /api/oauth/token for /api/mcp, and accepts its own OAuth access tokens there
MCP_OAUTH_RESOURCES=   # comma-separated public URLs of /api/mcp tokens may be issued for, e.g. https://willder.ai/api/mcp; a host not listed gets 503 from its discovery document
MCP_CONFORMANCE_AGENTS= # comma-separated orgId/agentId pairs served the MCP conformance suite's fixtures on X-Willder-Conformance: fixtures; unset = nobody

# ---- Memory graph: Neo4j, also read here for the daily keep-alive job ----
NEO4J_URI=             # bolt://localhost:7687 locally; the memory service reads the same names
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=        # willder-local in the README docker command

# ---- Uploads: Vercel Blob ----
BLOB_READ_WRITE_TOKEN= # unset = uploads are extracted inline through the memory service

# ---- Connectors and sources (mock mode by default) ----
NEXT_PUBLIC_CONNECTORS_ENABLED=  # true = show the Slack/Figma/PostHog/GitHub connectors panel
SLACK_MOCK=                      # false = real Slack (production always real)
FIGMA_MOCK=                      # false = real Figma (production always real)
GDRIVE_MOCK=                     # false = real Google Drive on the server
NEXT_PUBLIC_GDRIVE_MOCK=         # false = real Google Drive picker in the browser
NEXT_PUBLIC_GOOGLE_CLIENT_ID=    # Drive picker (browser)
NEXT_PUBLIC_GOOGLE_API_KEY=      # Drive picker (browser)
MAILBOX_OAUTH_MOCK=              # false = real Gmail/Outlook OAuth
GOOGLE_CLIENT_ID=                # Gmail OAuth
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=             # Outlook OAuth
MICROSOFT_CLIENT_SECRET=
GITHUB_TOKEN=                    # optional; raises the rate limit for GitHub secret-scanning key fetches

# ---- Audit log retention ----
# Unset or "forever" keeps audit rows indefinitely; a number of days must be at least 184.
# AUDIT_LOG_RETENTION_DAYS=forever

# ---- Analytics ----
NEXT_PUBLIC_POSTHOG_KEY=  # unset = no analytics and no error reporting
POSTHOG_HOST=  # server error reports; unset = https://us.i.posthog.com

# ---- Billing: Stripe (payments stay off until PAYMENTS_ENABLED is true) ----
PAYMENTS_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Account enrichment ----
ENRICHMENT_APOLLO_ENABLED=  # 1 = spend Apollo credits on firmographics
APOLLO_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# ---- Launch-update signups (landing page); all of RESEND_* and UPDATES_FROM_EMAIL or the form is closed ----
RESEND_API_KEY=
RESEND_UPDATES_SEGMENT_ID=          # Resend segment confirmed subscribers join
UPDATES_FROM_EMAIL=                 # verified sender, e.g. "Willder <updates@example.com>"
LAUNCH_UPDATES_ADMIN_CLERK_ORG_ID=  # Clerk org (org_...) allowed to export subscribers; unset = nobody

# ---- Tracing: Langfuse (no-op when unset) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# ---- Agent feature flags (default off) ----
HANDOFF_MANAGER=  # true = Handoff fan-out manager
ARCH_MANAGER=     # true = Architecture manager route
QA_MANAGER=       # true = QA manager route
WRITE_ROUTING_POLICY=  # true = write-side routing policy (inert until W5)

# ---- QA agent browser isolation: Vercel Sandbox (default: in-process Chromium) ----
QA_SANDBOX=                 # true = drive Chromium inside a Vercel Sandbox (needs @vercel/sandbox)
VERCEL_TOKEN=               # all three, or none: on Vercel the SDK authenticates by OIDC
VERCEL_TEAM_ID=             #   (VERCEL_OIDC_TOKEN, supplied by the platform, not set by hand)
VERCEL_PROJECT_ID=
AGENT_BROWSER_SNAPSHOT_ID=  # optional pre-built sandbox snapshot for fast starts

# ---- Tuning (defaults in code) ----
GRAPHITI_SEARCH_TIMEOUT_MS=  # 8000
GRAPHITI_GRAPH_TIMEOUT_MS=   # 15000
GRAPHITI_TIMEOUT_MS=         # 20000

# ---- MCP server (per run, not usually stored here) ----
# WILLDER_CAPABILITY_TOKEN=  # npm run mcp exits without one; mint with scripts/dev-token.ts

# ---- Build and platform (set by Vercel or the deploy, not by hand) ----
ALLOW_PRISMA_MIGRATE_DEPLOY=  # 1 = build.sh runs migrations outside Vercel
MIGRATE_LOCK_ATTEMPTS=        # build.sh retry count on Prisma advisory-lock timeout (6)
MIGRATE_LOCK_WAIT_SECONDS=    # seconds between those retries (10)
